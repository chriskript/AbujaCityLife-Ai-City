{
  "name": "abuja-city-life-ai-city-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Original hackathon testbed for validated AI decisions in a simulated neighbourhood.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "backend:init": "tsx scripts/backend-init.ts",
    "backend": "tsx scripts/backend.ts",
    "dev": "vite --config vite.config.ts",
    "build": "npm run typecheck && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --project client/tsconfig.json",
    "demo": "tsx scripts/demo.ts",
    "demo:neighbourhood": "tsx scripts/demo-neighbourhood.ts",
    "town:headless": "tsx scripts/town-headless.ts",
    "probe:meta": "tsx scripts/probe-meta.ts",
    "meta:check": "tsx scripts/check-meta.ts",
    "autonomy:dry-run": "tsx scripts/autonomy-dry-run.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
