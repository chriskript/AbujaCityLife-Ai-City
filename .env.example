# Server-side only. Never prefix credentials with VITE_.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Town inference reservations persist in runtime/meta-probe-budget.json.
# Keep this storage across runs; do not reset it to bypass spending limits.
META_PROBE_TOTAL_USD=1
# Optional inclusive Lagos date for a temporary cumulative allowance; then reverts to at most $1.
# META_PROBE_TOTAL_USD_UNTIL=2026-11-04
META_PROBE_DAILY_USD=0.25
# Optional inclusive Lagos date for a temporary daily allowance; then reverts to at most $0.25/day.
# META_PROBE_DAILY_USD_UNTIL=2026-11-04
